# Copy to .env before running docker compose:
#
#   cp .env.example .env
#   echo "JWT_SECRET=$(openssl rand -hex 32)" > .env
#
# .env is gitignored. Keeping the secret in a file (rather than passing it
# inline each time) means restarts and `docker compose up` reuse the same
# secret, so previously issued tokens stay valid.
JWT_SECRET=
